DATABASE_URL=postgres://travel:travel@localhost:5432/travel_planner
PORT=3001
# Optional. Without it places come from a small built-in list (development and tests).
# GOOGLE_MAPS_API_KEY=
# Optional, read by the web app (Map View). A separate browser key, restricted to this site and to the
# Maps JavaScript API. Without it the Map View shows a sample map.
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAP_ID=
# Optional. AI generation (step 23b, ADR 0008). Without a key a fake generator answers with a few
# days around Kyoto. OPENAI_MODEL is the model it uses (gpt-6.1-sol when not set); the API prints it
# when it starts.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Auth0 (ADR 0006). Without a tenant, development uses a fake login (any "Log in" click logs in as
# lena@example.com; window.__fakeAuth.expire() ends the session). The API only accepts the fake
# tokens that go with it when AUTH_FAKE=1 is set; it never does in production, and it refuses to
# start with neither AUTH_FAKE=1 nor AUTH0_DOMAIN and AUTH0_AUDIENCE.
AUTH_FAKE=1
# AUTH0_DOMAIN=your-tenant.eu.auth0.com
# AUTH0_AUDIENCE=https://api.travel-planner.example
# Editors (step 20): the site's address, used in invitation emails, and a machine-to-machine
# application (scope update:users) with which the API asks Auth0 to send the verification email again.
# Without the second pair the API only logs the request.
# APP_ORIGIN=http://localhost:5173
# AUTH0_M2M_CLIENT_ID=
# AUTH0_M2M_CLIENT_SECRET=
# Read by the web app; all three, or none. The domain is the same as above, the audience too.
# VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
# VITE_AUTH0_CLIENT_ID=
# VITE_AUTH0_AUDIENCE=https://api.travel-planner.example
